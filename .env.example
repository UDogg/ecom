# Local development defaults only. Copy to .env; never reuse these values anywhere public.

# ------------------------------------------------------------------
# Public URLs (what the BROWSER sees). Change these when deploying.
# ------------------------------------------------------------------
# The BFF: the only thing the browser talks to. It serves the storefront, the
# API and the sign-in pages from this one origin, so it is also the OIDC issuer
# the browser (and every token's `iss`) sees, and the base of links in e-mails.
PUBLIC_API_BASE_URL=http://localhost:8080
PUBLIC_WEB_URL=${PUBLIC_API_BASE_URL}
PUBLIC_AUTH_ISSUER_URL=${PUBLIC_API_BASE_URL}
PUBLIC_ASSET_BASE_URL=http://localhost:9000/product-images

# ------------------------------------------------------------------
# Internal URLs (service to service). Usually unchanged in Compose.
# ------------------------------------------------------------------
INTERNAL_AUTH_URL=http://auth-service:8081
INTERNAL_COMMERCE_URL=http://commerce-core:8000
INTERNAL_CATALOG_URL=http://catalog-reader:8082
INTERNAL_AUTH_JWKS_URL=http://auth-service:8081/oauth2/jwks
INTERNAL_INTELLIGENCE_URL=http://intelligence:8001
INTERNAL_PAYMENTS_URL=http://payments-sim:8003

# ------------------------------------------------------------------
# Datastores
# ------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=shop
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev-only-change-me
COMMERCE_DB_PASSWORD=dev-only-commerce
CATALOG_READER_DB_PASSWORD=dev-only-reader
INTELLIGENCE_DB_PASSWORD=dev-only-intel
AUTH_DB_PASSWORD=dev-only-auth
OUTBOX_PUBLISHER_DB_PASSWORD=dev-only-publisher
WORKER_DB_PASSWORD=dev-only-worker
PAYMENTS_DB_PASSWORD=dev-only-payments

REDIS_URL=redis://redis:6379/0
RABBITMQ_USER=shop
RABBITMQ_PASSWORD=dev-only-rabbit
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672/%2F
OPENSEARCH_URL=http://opensearch:9200

# ------------------------------------------------------------------
# Object storage (MinIO locally, any S3-compatible service later)
# ------------------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=product-images
S3_ACCESS_KEY=dev-minio
S3_SECRET_KEY=dev-only-minio-secret

# ------------------------------------------------------------------
# Auth
# ------------------------------------------------------------------
# The BFF is the only OAuth client: confidential, PKCE, tokens kept server-side.
OIDC_CLIENT_ID=bff
OIDC_CLIENT_SECRET=dev-only-oidc-client-secret-0123456789abcdef
OIDC_REDIRECT_URIS=${PUBLIC_API_BASE_URL}/auth/callback
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=28800
# Signs every BFF-to-core call; the cores refuse anything else (docs/request-signing.md).
# 32+ characters. In a deployment: `openssl rand -hex 32`, from a secret manager.
GATEWAY_SECRET=dev-only-gateway-secret-0123456789abcdef0123
# true behind HTTPS (the default when PUBLIC_API_BASE_URL is https://)
COOKIE_SECURE=false

# ------------------------------------------------------------------
# Privileged access when the BFF is down (docs/break-glass.md)
# ------------------------------------------------------------------
# Service accounts: name=client_id:sha256(secret)[|sha256(secret)],...  Empty = none.
# ./run.sh creates `ops` (operators; secret in .env.private) and the machine accounts
# `commerce` and `payments` (their secrets below, since those services must present them).
SERVICE_ACCOUNTS=
COMMERCE_SERVICE_CLIENT_ID=
COMMERCE_SERVICE_CLIENT_SECRET=
PAYMENTS_SERVICE_CLIENT_ID=
PAYMENTS_SERVICE_CLIENT_SECRET=
SERVICE_TOKEN_SECONDS=600
# SHA-256 of a random 16+ character password. Empty = break glass is switched off (404).
# ./run.sh generates one; the password itself lives only in .env.private.
BREAK_GLASS_PASSWORD_SHA256=
BREAK_GLASS_MINUTES=15
# Dev-only HS256 tokens (`manage.py dev_token`). Empty = only auth-service tokens are accepted.
JWT_DEV_HS256_SECRET=
# Create the seed accounts below on auth-service start. Never true in a deployment.
AUTH_SEED_ENABLED=true

# ------------------------------------------------------------------
# commerce-core (Django)
# ------------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-django-secret-change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,commerce-core
RESERVATION_TTL_SECONDS=900
IDEMPOTENCY_RETENTION_HOURS=24

# ------------------------------------------------------------------
# Email
# ------------------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=orders@shop.local
OWNER_ALERT_EMAIL=owner@shop.local

# ------------------------------------------------------------------
# Async processing (outbox-publisher, worker)
# ------------------------------------------------------------------
WORKER_RETRY_DELAYS_MS=5000,30000,120000   # one retry per value, then the dead-letter queue
WORKER_PREFETCH=10
LOW_STOCK_THRESHOLD=5

# ------------------------------------------------------------------
# Seed data (dev only)
# ------------------------------------------------------------------
SEED_OWNER_EMAIL=owner@shop.local
SEED_OWNER_PASSWORD=dev-only-owner-pass
SEED_CUSTOMER_EMAIL=customer@shop.local
SEED_CUSTOMER_PASSWORD=dev-only-customer-pass

# ------------------------------------------------------------------
# Behaviour switches
# ------------------------------------------------------------------
SEARCH_BACKEND=postgres        # postgres | opensearch
CHAOS_ENABLED=false            # enables chaos endpoints in payments-sim and intelligence
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOG_LEVEL=info
