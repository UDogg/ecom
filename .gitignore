# Secrets: only .env.example is committed
.env
.env.local
.env.private

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Node / Go / Java build output (later phases)
node_modules/
.next/
out/
target/
bin/

# Benchmarks
bench/results/*
!bench/results/.gitkeep

# Stress arena runs (each run writes a JSONL log and an HTML scorecard)
stress/reports/*
!stress/reports/.gitkeep

.DS_Store
/.bench-loadgen
/_site/

# Demo backend URL, provisioned at build time and cached by CI
site/.backend-url
