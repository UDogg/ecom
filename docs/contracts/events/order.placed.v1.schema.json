{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shop.local/contracts/events/order.placed.v1.schema.json",
  "title": "order.placed v1 data",
  "type": "object",
  "required": ["id", "status", "total_minor", "currency", "items", "customer_id"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "status": {"type": "string"},
    "total_minor": {"type": "integer", "minimum": 0},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "created_at": {"type": "string"},
    "customer_id": {"type": "string", "format": "uuid"},
    "customer_email": {"type": ["string", "null"]},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["product_id", "sku", "name", "quantity", "unit_price_minor"],
        "properties": {
          "product_id": {"type": "string"},
          "sku": {"type": "string"},
          "name": {"type": "string"},
          "quantity": {"type": "integer", "minimum": 1},
          "unit_price_minor": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
