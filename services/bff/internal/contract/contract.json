   "upstream": "/api/commerce/orders/{id}",
   "auth": "customer",
   "response": "order"
  },
  {
   "name": "admin.products.list",
   "method": "GET",
   "path": "/api/admin/products",
   "service": "commerce",
   "upstream": "/api/commerce/admin/products",
   "auth": "shop_owner",
   "query": {
    "status": {
     "type": "string",
     "enum": [
      "draft",
      "active",
      "archived"
     ]
    },
    "category": {
     "type": "slug",
     "max": 80
    },
    "q": {
     "type": "string",
     "max": 100
    },
    "page": {
     "type": "int",
     "min": 1,
     "max": 10000
    },
    "page_size": {
     "type": "int",
     "min": 1,
     "max": 100
    }
   },
