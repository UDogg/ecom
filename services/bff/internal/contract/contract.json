  {
   "name": "admin.products.create",
   "method": "POST",
   "path": "/api/admin/products",
   "service": "commerce",
   "upstream": "/api/commerce/admin/products",
   "auth": "shop_owner",
   "body": {
    "name": {
     "type": "string",
     "min": 1,
     "max": 200,
     "required": true
    },
    "description": {
     "type": "string",
     "max": 20000
    },
    "price_minor": {
     "type": "int",
     "min": 0,
     "max": 1000000000000,
     "required": true
    },
    "currency": {
     "type": "string",
     "min": 3,
     "max": 3
    },
    "category": {
     "type": "slug",
     "max": 80,
     "required": true
    },
    "category_name": {
     "type": "string",
     "max": 120
    },
    "status": {
     "type": "string",
     "enum": [
      "draft",
      "active"
     ]
    },
    "image_keys": {
     "type": "strings",
     "max": 8,
     "of": {
      "type": "image_key"
     }
    },
    "sku": {
     "type": "sku",
     "required": true
    },
    "initial_stock": {
     "type": "int",
     "min": 0,
     "max": 1000000000
    }
   },
   "response": "product_admin",
   "response_headers": [
    "ETag"
   ]
  },
