   "auth": "public",
   "response": "product_public"
  },
  {
   "name": "catalog.categories",
   "method": "GET",
   "path": "/api/catalog/categories",
   "service": "catalog",
   "upstream": "/api/catalog/categories",
   "auth": "public",
   "response": "category_tree"
  },
  {
   "name": "recommendations",
   "method": "GET",
   "path": "/api/recommendations",
   "service": "intelligence",
   "upstream": "/api/intelligence/recommendations",
   "auth": "public",
   "query": {
    "product_id": {
     "type": "uuid"
    },
    "limit": {
     "type": "int",
     "min": 1,
     "max": 20
    }
   },
   "response": "recommendations",
   "timeout_ms": 800,
   "degrade": {
    "status": 200,
    "body": {
     "items": [],
     "strategy": "none",
     "degraded": true
    }
   }
  },
  {
   "name": "auth.register",
   "method": "POST",
   "path": "/api/auth/register",
   "service": "auth",
   "upstream": "/api/auth/register",
   "auth": "public",
   "body": {
    "email": {
     "type": "email",
     "max": 254,
     "required": true
    },
    "password": {
     "type": "string",
     "min": 12,
     "max": 128,
     "required": true
    }
   },
   "response": "registered",
   "limit": "register"
  },
  {
   "name": "cart.get",
   "method": "GET",
   "path": "/api/cart",
   "service": "commerce",
   "upstream": "/api/commerce/cart",
   "auth": "customer",
   "response": "cart"
  },
  {
   "name": "cart.put",
   "method": "PUT",
   "path": "/api/cart",
   "service": "commerce",
   "upstream": "/api/commerce/cart",
   "auth": "customer",
   "body": {
    "items": {
     "type": "list",
     "max": 50,
     "required": true,
     "item": {
      "product_id": {
       "type": "uuid",
       "required": true
      },
      "quantity": {
       "type": "int",
       "min": 1,
       "max": 1000,
       "required": true
      }
     }
    }
   },
   "response": "cart"
  },
  {
   "name": "checkout",
   "method": "POST",
   "path": "/api/checkout",
   "service": "commerce",
   "upstream": "/api/commerce/checkout",
   "auth": "customer",
   "body": {
    "items": {
     "type": "list",
     "max": 50,
     "required": true,
     "item": {
      "product_id": {
       "type": "uuid",
       "required": true
      },
      "quantity": {
       "type": "int",
       "min": 1,
       "max": 1000,
       "required": true
      }
     }
    }
   },
   "response": "order",
   "request_headers": [
    "Idempotency-Key"
   ],
   "response_headers": [
    "Idempotent-Replayed"
   ],
   "limit": "checkout",
   "timeout_ms": 10000
  },
  {
   "name": "orders.list",
