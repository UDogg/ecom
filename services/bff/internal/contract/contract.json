 "endpoints": [
  {
   "name": "catalog.list",
   "method": "GET",
   "path": "/api/catalog/products",
   "service": "catalog",
   "upstream": "/api/catalog/products",
   "auth": "public",
   "query": {
    "category": {
     "type": "slug",
     "max": 80
    },
    "q": {
     "type": "string",
     "max": 100
    },
    "min_price": {
     "type": "int",
     "min": 0
    },
    "max_price": {
     "type": "int",
     "min": 0
    },
    "page": {
     "type": "int",
     "min": 1,
     "max": 10000
    },
    "page_size": {
     "type": "int",
     "min": 1,
     "max": 100
    }
   },
   "response": "product_page"
  },
  {
   "name": "catalog.search",
   "method": "GET",
   "path": "/api/catalog/search",
   "service": "catalog",
   "upstream": "/api/catalog/products",
   "auth": "public",
   "query": {
    "category": {
     "type": "slug",
     "max": 80
    },
    "q": {
     "type": "string",
     "max": 100
    },
    "min_price": {
